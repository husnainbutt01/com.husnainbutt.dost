{
	"appId": "com.husnainbutt.dost",
	"appName": "DOST",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"allowNavigation": [
			"*.firebaseapp.com",
			"*.googleapis.com",
			"*.gstatic.com",
			"accounts.google.com"
		]
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	}
}
